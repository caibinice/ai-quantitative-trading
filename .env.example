# Copy this file to .env. Never commit real secrets.
APP_ENV=development
ROOT_PATH=
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_quantitative_trading?charset=utf8mb4

# Optional: if DATABASE_URL / LLM_* are omitted, the app can read the local,
# git-ignored credentials file used by this workspace.
CREDENTIALS_FILE=credentials.txt

LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_API_KEY_BACKUP=
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=max
BLOG_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
BLOG_NEWS_CACHE_SECONDS=21600
BLOG_NEWS_STALE_SECONDS=604800
BLOG_NEWS_SEED_FILE=

# Browser-triggered write/AI operations use a short-lived backend token.
ACTION_PASSWORD=replace-with-a-strong-operation-password
ACTION_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACTION_TOKEN_TTL_MINUTES=30

# Data collection. Keep the scheduler disabled until the watchlist is reviewed.
SCHEDULER_ENABLED=false
DEFAULT_WATCHLIST=000001,000333,000651,000858,002415,002594,300750,600000,600036,600276,600519,601318,601398,601857,601899
UPSTREAM_PROXY=
CORS_ORIGINS=http://localhost:5173
PRICE_SYNC_CRON=20 18 * * 1-5
SCORE_CRON=40 19 * * 1-5
INFRASTRUCTURE_CRON=10 8 * * 6
DATA_QUALITY_CRON=10 20 * * 1-5
