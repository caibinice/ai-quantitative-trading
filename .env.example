# Copy this file to .env. Never commit real secrets.
APP_ENV=development
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_quantitative_trading?charset=utf8mb4

# Optional: if DATABASE_URL / LLM_* are omitted, the app can read the local,
# git-ignored credentials file used by this workspace.
CREDENTIALS_FILE=credentials.txt

LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Data collection. Keep the scheduler disabled until the watchlist is reviewed.
SCHEDULER_ENABLED=false
DEFAULT_WATCHLIST=000001,600519,300750,601318,000858
UPSTREAM_PROXY=
CORS_ORIGINS=http://localhost:5173
PRICE_SYNC_CRON=20 18 * * 1-5
NEWS_SYNC_CRON=0 */2 * * *
SCORE_CRON=40 19 * * 1-5
INFRASTRUCTURE_CRON=10 8 * * 6
DATA_QUALITY_CRON=10 20 * * 1-5
