server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    auth_basic "AI Quant Research Cockpit";
    auth_basic_user_file __APP_ROOT__/shared/htpasswd;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root __APP_ROOT__/shared/acme;
        default_type text/plain;
    }

    location /quant/api/ {
        limit_req zone=ai_quant_limit burst=50 nodelay;
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /quant/docs {
        proxy_pass http://127.0.0.1:8000/docs;
        proxy_set_header Host $host;
    }

    location = /quant/openapi.json {
        proxy_pass http://127.0.0.1:8000/openapi.json;
        proxy_set_header Host $host;
    }

    location = / {
        return 302 /quant/;
    }

    location = /quant {
        return 301 /quant/;
    }

    location /quant/assets/ {
        root __APP_ROOT__/www;
        try_files $uri =404;
        expires off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /quant/ {
        root __APP_ROOT__/www;
        try_files $uri $uri/ /quant/index.html;
    }

    location / {
        return 404;
    }
}
